# Plantilla de secretos para correr la app de Streamlit en tu PC.
# 1. Copia este archivo como  .streamlit/secrets.toml  (ese archivo NO se sube a GitHub).
# 2. Pega los valores de Supabase → Project Settings → API.
# En Streamlit Cloud los mismos valores van en: App → Settings → Secrets.
SUPABASE_URL = "https://TU-PROYECTO.supabase.co"
SUPABASE_KEY = "PEGA_AQUI_LA_ANON_KEY"
